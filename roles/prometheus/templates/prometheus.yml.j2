# {{ ansible_managed }}
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_rule_interval }}

rule_files:
  - {{ obs_config_dir }}/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:{{ alertmanager_port | default(9093) }}"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ prometheus_port }}"]

  - job_name: node
    static_configs:
      - targets:
{% for host in groups['monitored'] | default([]) %}
          - "{{ '127.0.0.1' if host == 'localhost' else (hostvars[host].ansible_host | default(host)) }}:{{ hostvars[host].node_exporter_port | default(9100) }}"
{% endfor %}

  - job_name: alertmanager
    static_configs:
      - targets: ["127.0.0.1:{{ alertmanager_port | default(9093) }}"]

  - job_name: statsd
    static_configs:
      - targets: ["127.0.0.1:{{ statsd_exporter_web_port | default(9102) }}"]

  - job_name: vector
    static_configs:
      - targets: ["127.0.0.1:{{ vector_prometheus_port | default(9598) }}"]

  - job_name: {{ slo_service }}
    static_configs:
      - targets: ["127.0.0.1:{{ demo_app_port | default(8000) }}"]

  - job_name: grafana
    static_configs:
      - targets: ["127.0.0.1:{{ grafana_port | default(3000) }}"]
